# Leave both of these blank to run the local demo. No account is required.
# Fill them in after you create a Supabase project. Then restart `npm run dev`
# (or redeploy on Vercel — Next.js bakes NEXT_PUBLIC_ values in at build time).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Auth emails return here. If empty, the app uses the browser's origin.
# On Vercel set this to https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
